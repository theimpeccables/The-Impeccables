  "description": "Backend API for The Impeccables Club Management Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --watch-path=src src/server.js",
    "start:production": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "seed": "node src/scripts/seed.js",
