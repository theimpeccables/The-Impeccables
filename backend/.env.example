# App
NODE_ENV=development
PORT=5001
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Authentication (replace with independent random secrets, at least 32 chars)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=theimpeccables-api
JWT_AUDIENCE=theimpeccables-web

# Cookies (set COOKIE_SECURE=true behind HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_BYTES=52428800

# Brevo SMTP relay. Use the account-specific SMTP login, not the relay hostname.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CONTACT_EMAIL=

# Optional Redis/Upstash connection for background jobs
REDIS_URL=

# Optional first-admin bootstrap (only used by the explicit seed command)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional local QA accounts (shared password for generated .test accounts)
TEST_ACCOUNT_PASSWORD=
