# Copy to .env for the root development scripts. Never commit populated values.
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:5001/api

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=theimpeccables-api
JWT_AUDIENCE=theimpeccables-web
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudinary account values
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_BYTES=52428800

# Brevo SMTP relay. Set the account-specific SMTP login and key locally.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CONTACT_EMAIL=

# Optional Redis/Upstash URL for queued jobs
REDIS_URL=

# Used only by the explicit database seed command
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
